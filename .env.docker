# ------------------------------------------------------------
# Docker deployment template — copy to .env and customize
# ------------------------------------------------------------
APP_NAME=Zephyr
APP_ENV=production
APP_KEY=                          # fill with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://localhost:8080
# Reverse proxies allowed to set X-Forwarded-* headers ("*" or comma separated IPs/CIDRs),
# required behind a TLS terminating proxy to generate https URLs
TRUSTED_PROXIES=
APP_PORT=8080

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# Project metadata and branding
# ------------------------------------------------------------
APP_PROJECT_NAME=Zephyr
APP_FAVICON="images/favicon.svg"
APP_FAVICON_SVG="images/favicon.svg"
APP_FAVICON_PNG_32="images/favicon.png"
APP_FAVICON_ICO="images/favicon.ico"
APP_APPLE_TOUCH_ICON="images/favicon_180x180.png"
APP_LOGO="images/logo.svg"

APP_DIAGNOSTICS_ENABLED=false

# ------------------------------------------------------------
# Localization
# ------------------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOCALE=en
FALLBACK_LOCALE=en
CALENDAR_TIMEZONE=UTC
DATE_FORMAT=Y-m-d
DATETIME_FORMAT="Y-m-d H:i"

# ------------------------------------------------------------
# Bootstrap admin account
# ------------------------------------------------------------
BOOTSTRAP_ADMIN_NAME="Admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD=change-me-in-production
SEED_DEMO_DATA=false

# ------------------------------------------------------------
# Work schedule defaults
# ------------------------------------------------------------
ZPH_TIME_START_WORK=09:00
ZPH_TIME_END_WORK=17:00
ZPH_WORK_DAYS=1,2,3,4,5

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Bundled MariaDB (default): keep COMPOSE_PROFILES=database and DB_HOST=db.
# Existing database: set COMPOSE_PROFILES= (empty) and point DB_* to it:
#   - on the host machine: DB_HOST=host.docker.internal
#   - on another container network: DB_HOST=<container name> and
#     DB_EXTERNAL_NETWORK=<network>, then add docker-compose.external-network.yml
#   - on a remote server: DB_HOST=<hostname or IP>
# The database must be dedicated to Zephyr (see README, "Existing database").
COMPOSE_PROFILES=database
# mariadb or mysql
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=zephyr
DB_USERNAME=zephyr
DB_PASSWORD=change-me-in-production
# Root password of the bundled database only
DB_ROOT_PASSWORD=change-me-in-production
#DB_EXTERNAL_NETWORK=
# CA certificate for TLS connections to a remote database (path inside the container)
#MYSQL_ATTR_SSL_CA=/var/www/html/storage/app/db-ca.pem
# Seconds the app waits for the database at startup
DB_WAIT_TIMEOUT=120

# ------------------------------------------------------------
# Redis — host must match the redis service name in Compose
# ------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------
# Core drivers — use Redis in production
# ------------------------------------------------------------
BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Send the session cookie over HTTPS only (empty = enabled when APP_URL uses https)
SESSION_SECURE_COOKIE=

SCOPE_DELETE_GRACE_HOURS=24

# ------------------------------------------------------------
# Mail
# ------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
# API (Sanctum)
# ------------------------------------------------------------
# Minutes until an API token expires (default 525600 = 1 year, 0 = tokens never expire)
SANCTUM_TOKEN_EXPIRATION=525600
# Maximum API requests per minute per user/IP
API_RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------
# Backups (spatie/laravel-backup)
# ------------------------------------------------------------
# Recipient of backup success/failure notifications (defaults to MAIL_FROM_ADDRESS)
BACKUP_NOTIFICATION_EMAIL=
# Password used to encrypt backup archives (strongly recommended: archives include .env
# and the database dump). Store it outside the server: it is needed to restore a backup
BACKUP_ARCHIVE_PASSWORD=
# Scheduled backups (backup:run/clean/monitor); disable when backed up elsewhere
BACKUP_ENABLED=true

# ------------------------------------------------------------
# Optional AWS storage
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
