{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && node bin/build.js",
        "dev": "concurrently --kill-others --names=vite,esbuild --prefix-colors=blue,magenta \"vite\" \"node bin/build.js --dev\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "esbuild": "^0.28.0",
        "html5-qrcode": "^2.3.8",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
